# ---------------------------------------------------------------------------
# IMPORTANT -- do NOT add blanket ignores for generated mathematical data.
#
# Files under data/ (order-type representatives, exceptional profiles,
# survivor sets, certificates, SHA256SUMS) are generated, but they are the
# auditable content of this project and MUST be committed.
#
# The regenerable intermediate pickles below are ignored ONLY because they are
# large, machine-specific binary blobs that any user can rebuild in minutes
# with the documented commands (see docs/computational-method.md).  Their
# SHA-256 digests are recorded in data/hashes/SHA256SUMS instead.
# ---------------------------------------------------------------------------
*.pkl
!data/**/*.pkl

# Implementation B compiled binary (rebuild with the command in its README)
independent/implementation_b/reduction

# Reference PDFs: published papers, identified by DOI and SHA-256 in
# references/README.md rather than redistributed here (Springer DCG article
# is not freely redistributable).
references/*.pdf

# LaTeX build intermediates (the PDF itself is committed)
paper/*.aux
paper/*.log
paper/*.bbl
paper/*.blg
paper/*.out
paper/*.toc
paper/*.synctex.gz

# no-A7 experiment: compiled binary and regenerable intermediates
independent/no_a7_experiment/reduction_a7opt
independent/no_a7_experiment/*.pkl
# py_no_a7.json duplicates cpp_no_a7.json (same 2,412 triples, two code paths);
# keep the C++ one as the committed artifact.
independent/no_a7_experiment/py_no_a7.json
independent/no_a7_experiment/py_with_a7.json
