# ---------------------------------------------------------------------------
# Local agent/tool state
#
# Machine-local only.  This was previously covered by a *global* gitignore on
# the author's machine, so it did not show up here but WOULD show up in any
# fresh clone.  Committed to the repository ignore list so the working tree is
# clean everywhere.
# ---------------------------------------------------------------------------
.claude/settings.local.json

# ---------------------------------------------------------------------------
# Scratch / transient run output
# ---------------------------------------------------------------------------
scratch/
tmp/
*.tmp
nohup.out

# ---------------------------------------------------------------------------
# IMPORTANT -- do NOT add blanket ignores for generated mathematical data.
#
# Files under data/ (order-type representatives, exceptional profiles,
# survivor sets, certificates, SHA256SUMS) are generated, but they are the
# auditable content of this project and MUST be committed.
#
# The regenerable intermediate pickles below are ignored ONLY because they are
# large, machine-specific binary blobs that any user can rebuild in minutes
# with the documented commands (see docs/computational-method.md).  Their
# SHA-256 digests are recorded in data/hashes/SHA256SUMS instead.
# ---------------------------------------------------------------------------
*.pkl
!data/**/*.pkl

# Implementation B compiled binary (rebuild with the command in its README)
independent/implementation_b/reduction

# Reference PDFs: published papers, identified by DOI and SHA-256 in
# references/README.md rather than redistributed here (Springer DCG article
# is not freely redistributable).
references/*.pdf

# LaTeX build intermediates (the PDF itself is committed)
paper/*.aux
paper/*.log
paper/*.bbl
paper/*.blg
paper/*.out
paper/*.toc
paper/*.synctex.gz

# no-A7 experiment: compiled binary and regenerable intermediates
independent/no_a7_experiment/reduction_a7opt
independent/no_a7_experiment/*.pkl
# py_no_a7.json duplicates cpp_no_a7.json (same 2,412 triples, two code paths);
# keep the C++ one as the committed artifact.
independent/no_a7_experiment/py_no_a7.json
independent/no_a7_experiment/py_with_a7.json

# A7 reproduction: compiled/scratch artefacts
independent/akr_l7_reproduction/__pycache__/

# A7 reproduction: 24MB of generated DIMACS CNF.  Regenerable deterministically;
# SHA-256 of every file is committed in CNF_SHA256SUMS.txt so the UNSAT results
# remain independently re-checkable by regenerating and comparing hashes.
independent/akr_l7_reproduction/cnf/
independent/akr_l7_reproduction/__pycache__/

# A7 evidence: 19MB of CNF, regenerable byte-identically in ~2s by
# evidence/regen_cnf.py.  The 15 DRAT refutations ARE committed (small and not
# re-derivable without a solver).  Hashes for everything in evidence/SHA256SUMS.txt.
independent/akr_l7_reproduction/evidence/cnf/
independent/akr_l7_reproduction/evidence/fixtures/negative/
independent/akr_l7_reproduction/evidence/**/__pycache__/

# Fresh verification run output (historical logs under evidence/logs/ are tracked
# and must stay distinct from re-run output).
runs-local/

# Generator scratch: regenerable caches and staged-but-unbuilt Lean modules
.cache/

# Residual-realizability CNFs: 4.2 MB each, regenerated byte-identically by
# verify.py and digest-checked against SHA256SUMS.txt.  The DRAT proofs ARE
# committed (8-12 KB and not regenerable without a solver).
independent/residual_realizability/*.cnf

# drat-trim binary: built from the pinned source by check_all.sh
independent/drat_trim_crosscheck/drat-trim

# ---------------------------------------------------------------------------
# independent/realizability_sweep -- compiled helpers and the per-instance logs.
# `orbits.txt` IS committed (581 KB, and everything downstream keys off it);
# the two .jsonl logs are ~10 MB and are regenerated by `sweep.py` and
# `verify_sweep.py` from it.  Their digests are in SHA256SUMS.txt.
# ---------------------------------------------------------------------------
independent/realizability_sweep/orbits
independent/realizability_sweep/cover
independent/realizability_sweep/bestpair
independent/realizability_sweep/*.jsonl
independent/realizability_sweep/__pycache__/

# ---------------------------------------------------------------------------
# independent/pattern_scaling -- the compiled search binary only.  Everything
# else in that directory (run.py, search.cpp, patterns.json, input.txt,
# run.log, README.md) is committed; `search` is rebuilt by run.py from
# search.cpp with a single `c++ -O3 -std=c++17` invocation.
# ---------------------------------------------------------------------------
independent/pattern_scaling/search

# ---------------------------------------------------------------------------
# independent/pi8_human -- the compiled probe binaries only.  Every .c source
# and NOTES.md are committed; each binary is rebuilt from the source beside it
# with a single `cc -O2 -o <name> <name>.c`.  They read the TU Graz order-type
# database at independent/order_type_audit/external/otypes08.b08.
# ---------------------------------------------------------------------------
independent/pi8_human/pat
independent/pi8_human/sigtypes
independent/pi8_human/lemma_probe
independent/pi8_human/lemma_probe2
independent/pi8_human/probe2
independent/pi8_human/probe3
independent/pi8_human/probe4
independent/pi8_human/probe5
independent/pi8_human/probe6
independent/pi8_human/probe7
independent/pi8_human/probe8
independent/pi8_human/probe9
independent/pi8_human/forced
independent/pi8_human/forced2
independent/pi8_human/proofcheck

# ---------------------------------------------------------------------------
# independent/pi14_split -- pycache, and the sharded re-run logs, which were
# still being written when the directory was committed.  The completed
# 256-branch census log (census_v3.log) and the finished logs ARE committed;
# the shard logs are regenerated by run_census_shards.sh / run_census4.sh.
# ---------------------------------------------------------------------------
independent/pi14_split/__pycache__/
independent/pi14_split/shard_census_*.log
independent/pi14_split/census4_*.log

# Personal study guide -- not part of the published artifact.
# Remove this line if it is ever made public.
studyguide/
