/-- The 35 increasing triples with their lexicographic indices. -/
def tripIdx : List (Nat × Nat × Nat × Nat) := [(0, 0, 1, 2), (1, 0, 1, 3), (2, 0, 1, 4), (3, 0, 1, 5), (4, 0, 1, 6), (5, 0, 2, 3), (6, 0, 2, 4), (7, 0, 2, 5), (8, 0, 2, 6), (9, 0, 3, 4), (10, 0, 3, 5), (11, 0, 3, 6), (12, 0, 4, 5), (13, 0, 4, 6), (14, 0, 5, 6), (15, 1, 2, 3), (16, 1, 2, 4), (17, 1, 2, 5), (18, 1, 2, 6), (19, 1, 3, 4), (20, 1, 3, 5), (21, 1, 3, 6), (22, 1, 4, 5), (23, 1, 4, 6), (24, 1, 5, 6), (25, 2, 3, 4), (26, 2, 3, 5), (27, 2, 3, 6), (28, 2, 4, 5), (29, 2, 4, 6), (30, 2, 5, 6), (31, 3, 4, 5), (32, 3, 4, 6), (33, 3, 5, 6), (34, 4, 5, 6)]

/-- Relabel by `w.perm`, optionally flip every sign, and repack into 35 bits. -/
def applyW (w : W) (v : Nat) : Nat :=
  tripIdx.foldl (fun acc t =>
    let r := t.1; let a := t.2.1; let b := t.2.2.1; let c := t.2.2.2
    let s := (if w.neg then -1 else 1) *
             chiB v (w.perm.getD a 0) (w.perm.getD b 0) (w.perm.getD c 0)
    if s > 0 then acc ||| (1 <<< r) else acc) 0

