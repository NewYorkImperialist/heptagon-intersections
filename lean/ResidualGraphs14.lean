theorem shard14_impossible (V : Fin 14 → Pt) (hGP : GP V)
    (hSP : SimpleP V) (hSQ : SimpleQ V) (g : Fin 7 → Nat)
    (hg : g ∈ shard14) (hR : Realizes V g) : False := by
  simp only [shard14, List.mem_cons, List.not_mem_nil, or_false] at hg
