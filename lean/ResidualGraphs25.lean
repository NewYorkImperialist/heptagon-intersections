/-- Residual graphs 397-411 of the 412. -/
def shard25 : List (Fin 7 → Nat) :=
  [![96, 1, 1, 2, 12, 16, 16],
   ![96, 1, 1, 6, 8, 8, 16],
   ![96, 1, 1, 6, 8, 16, 16],
   ![96, 1, 2, 2, 12, 16, 16],
   ![96, 1, 2, 6, 8, 16, 16],
   ![96, 16, 8, 8, 6, 1, 1],
   ![96, 16, 8, 8, 6, 1, 64],
   ![96, 16, 8, 12, 2, 1, 1],
   ![96, 16, 12, 2, 2, 1, 64],
   ![96, 16, 16, 8, 6, 1, 1],
   ![96, 16, 16, 8, 6, 2, 1],
   ![96, 16, 16, 12, 2, 1, 1],
   ![96, 16, 16, 12, 2, 2, 1],
   ![96, 64, 1, 2, 12, 8, 16],
   ![96, 64, 1, 6, 8, 8, 16]]

theorem shard25_impossible (V : Fin 14 → Pt) (hGP : GP V)
    (hSP : SimpleP V) (hSQ : SimpleQ V) (g : Fin 7 → Nat)
    (hg : g ∈ shard25) (hR : Realizes V g) : False := by
  simp only [shard25, List.mem_cons, List.not_mem_nil, or_false] at hg
  rcases hg with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
  · exact graph397_impossible V hGP hSP hSQ hR
  · exact graph398_impossible V hGP hSP hSQ hR
  · exact graph399_impossible V hGP hSP hSQ hR
  · exact graph400_impossible V hGP hSP hSQ hR
  · exact graph401_impossible V hGP hSP hSQ hR
  · exact graph402_impossible V hGP hSP hSQ hR
  · exact graph403_impossible V hGP hSP hSQ hR
  · exact graph404_impossible V hGP hSP hSQ hR
  · exact graph405_impossible V hGP hSP hSQ hR
  · exact graph406_impossible V hGP hSP hSQ hR
  · exact graph407_impossible V hGP hSP hSQ hR
  · exact graph408_impossible V hGP hSP hSQ hR
  · exact graph409_impossible V hGP hSP hSQ hR
  · exact graph410_impossible V hGP hSP hSQ hR
  · exact graph411_impossible V hGP hSP hSQ hR

end Heptagon.ResidualSym
