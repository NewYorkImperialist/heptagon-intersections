    (hSP : SimpleP V) (hSQ : SimpleQ V)
    (hR : Realizes V ![96, 64, 1, 6, 8, 8, 16]) : False :=
  ResidualClauses001.orbit001_impossible
    (fun i => V (![4, 5, 6, 0, 1, 2, 3, 10, 11, 12, 13, 7, 8, 9] i))
