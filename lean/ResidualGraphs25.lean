    (hSP : SimpleP V) (hSQ : SimpleQ V)
    (hR : Realizes V ![96, 64, 1, 2, 12, 8, 16]) : False :=
  ResidualClauses003.orbit003_impossible
    (fun i => V (![7, 8, 9, 10, 11, 12, 13, 2, 3, 4, 5, 6, 0, 1] i))
    (gp_comp hGP _ (by decide))
    (hSQ 2 4 (by decide))
    (hSQ 2 5 (by decide))
    (pc_swapS (cross_of hR 3 2 (by decide)))
    (npc_swapS (not_cross_of hR 4 2 (by decide)))
    (pc_swapS (cross_of hR 5 2 (by decide)))
    (pc_swapS (cross_of hR 6 2 (by decide)))
    (pc_swapS (cross_of hR 0 2 (by decide)))
    (hSQ 3 5 (by decide))
    (pc_swapS (cross_of hR 2 3 (by decide)))
    (pc_swapS (cross_of hR 3 3 (by decide)))
    (npc_swapS (not_cross_of hR 4 3 (by decide)))
    (npc_swapS (not_cross_of hR 5 3 (by decide)))
    (pc_swapS (cross_of hR 6 3 (by decide)))
    (pc_swapS (cross_of hR 0 3 (by decide)))
    (pc_swapS (cross_of hR 1 3 (by decide)))
    (pc_swapS (cross_of hR 2 4 (by decide)))
    (pc_swapS (cross_of hR 3 4 (by decide)))
    (pc_swapS (cross_of hR 4 4 (by decide)))
    (pc_swapS (cross_of hR 5 4 (by decide)))
    (npc_swapS (not_cross_of hR 6 4 (by decide)))
    (pc_swapS (cross_of hR 0 4 (by decide)))
    (pc_swapS (cross_of hR 1 4 (by decide)))
    (pc_swapS (cross_of hR 2 5 (by decide)))
    (pc_swapS (cross_of hR 3 5 (by decide)))
    (pc_swapS (cross_of hR 4 5 (by decide)))
    (pc_swapS (cross_of hR 5 5 (by decide)))
    (pc_swapS (cross_of hR 6 5 (by decide)))
    (pc_swapS (cross_of hR 1 5 (by decide)))
    (hSP 2 4 (by decide))
    (hSP 2 5 (by decide))
    (hSP 2 6 (by decide))
    (hSP 3 5 (by decide))
    (hSP 3 6 (by decide))
    (hSP 4 6 (by decide))
    (hSP 4 1 (by decide))
    (hSP 5 0 (by decide))
    (hSP 5 1 (by decide))
    (hSP 6 1 (by decide))

