/-- Avoidance clause 39/548: a relabelled copy of forbidden
pattern 0 on the 8 listed side pairs does not occur. -/
theorem avoid0039 (V : Fin 14 → Pt) (hGP : GP V)
    (hSP : SimpleP V) (hSQ : SimpleQ V) :
    (Miss V 1 1) ∨ (Miss V 1 2) ∨ (Miss V 2 1) ∨ (¬ Miss V 2 2) ∨ (Miss V 2 3) ∨ (Miss V 3 1) ∨ (Miss V 3 2) ∨ (Miss V 3 3) := by
  by_contra hc
  have n1_1 : ¬ Miss V 1 1 := fun h => hc (Or.inl h)
  have n1_2 : ¬ Miss V 1 2 := fun h => hc (Or.inr (Or.inl h))
  have n2_1 : ¬ Miss V 2 1 := fun h => hc (Or.inr (Or.inr (Or.inl h)))
  have n2_2 : ¬ ¬ Miss V 2 2 := fun h => hc (Or.inr (Or.inr (Or.inr (Or.inl h))))
  have n2_3 : ¬ Miss V 2 3 := fun h => hc (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl h)))))
  have n3_1 : ¬ Miss V 3 1 := fun h => hc (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl h))))))
  have n3_2 : ¬ Miss V 3 2 := fun h => hc (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl h)))))))
  have n3_3 : ¬ Miss V 3 3 := fun h => hc (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (h))))))))
  exact MinPatternClauses000.minpattern000_impossible
    (fun i => V (![4, 3, 2, 1, 0, 6, 5, 8, 9, 10, 11, 12, 13, 7] i))
    (gp_comp hGP _ (by decide))
    (pc_swapL (cross_of_not_miss 3 1 n3_1))
    (pc_swapL (cross_of_not_miss 3 2 n3_2))
    (pc_swapL (cross_of_not_miss 3 3 n3_3))
    (pc_swapL (cross_of_not_miss 2 1 n2_1))
    (npc_swapL (miss_of_not_not 2 2 n2_2))
    (pc_swapL (cross_of_not_miss 2 3 n2_3))
    (pc_swapL (cross_of_not_miss 1 1 n1_1))
    (pc_swapL (cross_of_not_miss 1 2 n1_2))

end Heptagon.Cover
