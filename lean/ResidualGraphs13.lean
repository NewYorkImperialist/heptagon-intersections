def shard13 : List (Fin 7 → Nat) :=
  [![12, 16, 16, 32, 65, 2, 2],
   ![12, 16, 16, 96, 1, 1, 2],
   ![12, 16, 16, 96, 1, 2, 2],
   ![12, 16, 32, 32, 65, 2, 2],
   ![12, 16, 32, 32, 65, 2, 4],
