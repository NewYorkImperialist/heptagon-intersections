namespace Heptagon.Cover
open Heptagon.Geometry Finset


/-- Row `i` misses exactly 1 of the seven sides of `Q`, so it cannot miss all 2 of these. -/
theorem rowMost1_5_6 (V : Fin 14 → Pt) (i : Fin 7) (h : rowDeg V i = 1) :
    ¬ Miss V i 5 ∨ ¬ Miss V i 6 := by
  obtain ⟨j, hj, hp⟩ := row_exists_cross V (i := i) (S := {5, 6}) (by rw [h]; decide)
  simp only [Finset.mem_insert, Finset.mem_singleton] at hj
  rcases hj with rfl | rfl
  · exact Or.inl hp
  · exact Or.inr (hp)

/-- Row `i` misses exactly 1 of the seven sides of `Q`, so it cannot meet all 7 of these. -/
theorem rowLeast1_0_1_2_3_4_5_6 (V : Fin 14 → Pt) (i : Fin 7) (h : rowDeg V i = 1) :
    Miss V i 0 ∨ Miss V i 1 ∨ Miss V i 2 ∨ Miss V i 3 ∨ Miss V i 4 ∨ Miss V i 5 ∨ Miss V i 6 := by
  obtain ⟨j, hj, hp⟩ := row_exists_miss V (i := i) (S := {0, 1, 2, 3, 4, 5, 6}) (by rw [h]; decide)
  simp only [Finset.mem_insert, Finset.mem_singleton] at hj
  rcases hj with rfl | rfl | rfl | rfl | rfl | rfl | rfl
  · exact Or.inl hp
  · exact Or.inr (Or.inl hp)
  · exact Or.inr (Or.inr (Or.inl hp))
  · exact Or.inr (Or.inr (Or.inr (Or.inl hp)))
  · exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inl hp))))
  · exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl hp)))))
  · exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (hp))))))

