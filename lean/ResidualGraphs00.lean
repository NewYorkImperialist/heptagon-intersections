def shard00 : List (Fin 7 → Nat) :=
  [![1, 1, 2, 12, 8, 16, 96],
   ![1, 1, 2, 12, 16, 16, 96],
   ![1, 1, 6, 8, 8, 16, 96],
   ![1, 1, 6, 8, 8, 48, 64],
