/-- Residual graphs 191-205 of the 412. -/
def shard12 : List (Fin 7 → Nat) :=
  [![8, 48, 64, 1, 3, 4, 8],
   ![8, 48, 64, 64, 1, 2, 6],
   ![8, 48, 64, 64, 1, 6, 8],
   ![8, 48, 64, 64, 3, 4, 4],
   ![8, 48, 64, 64, 3, 4, 8],
   ![12, 2, 1, 1, 96, 16, 8],
   ![12, 2, 1, 1, 96, 16, 16],
   ![12, 2, 1, 64, 96, 16, 8],
   ![12, 2, 1, 65, 32, 16, 16],
   ![12, 2, 2, 1, 96, 16, 16],
   ![12, 2, 2, 65, 32, 16, 16],
   ![12, 2, 2, 65, 32, 32, 16],
   ![12, 4, 2, 65, 32, 32, 16],
   ![12, 8, 16, 96, 1, 1, 2],
   ![12, 16, 16, 32, 65, 1, 2]]

theorem shard12_impossible (V : Fin 14 → Pt) (hGP : GP V)
    (hSP : SimpleP V) (hSQ : SimpleQ V) (g : Fin 7 → Nat)
    (hg : g ∈ shard12) (hR : Realizes V g) : False := by
  simp only [shard12, List.mem_cons, List.not_mem_nil, or_false] at hg
  rcases hg with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
  · exact graph191_impossible V hGP hSP hSQ hR
  · exact graph192_impossible V hGP hSP hSQ hR
  · exact graph193_impossible V hGP hSP hSQ hR
  · exact graph194_impossible V hGP hSP hSQ hR
  · exact graph195_impossible V hGP hSP hSQ hR
  · exact graph196_impossible V hGP hSP hSQ hR
  · exact graph197_impossible V hGP hSP hSQ hR
  · exact graph198_impossible V hGP hSP hSQ hR
  · exact graph199_impossible V hGP hSP hSQ hR
  · exact graph200_impossible V hGP hSP hSQ hR
  · exact graph201_impossible V hGP hSP hSQ hR
  · exact graph202_impossible V hGP hSP hSQ hR
  · exact graph203_impossible V hGP hSP hSQ hR
  · exact graph204_impossible V hGP hSP hSQ hR
  · exact graph205_impossible V hGP hSP hSQ hR

