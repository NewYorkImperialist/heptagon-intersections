   ![64, 64, 1, 6, 4, 8, 48],
   ![64, 64, 1, 6, 8, 8, 48],
   ![64, 64, 3, 4, 4, 8, 48]]

theorem shard22_impossible (V : Fin 14 → Pt) (hGP : GP V)
    (hSP : SimpleP V) (hSQ : SimpleQ V) (g : Fin 7 → Nat)
    (hg : g ∈ shard22) (hR : Realizes V g) : False := by
  simp only [shard22, List.mem_cons, List.not_mem_nil, or_false] at hg
  rcases hg with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
  · exact graph349_impossible V hGP hSP hSQ hR
