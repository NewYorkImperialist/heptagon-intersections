/-- Residual graphs 349-364 of the 412. -/
def shard22 : List (Fin 7 → Nat) :=
  [![64, 32, 24, 8, 4, 2, 65],
   ![64, 32, 24, 8, 4, 3, 64],
   ![64, 32, 32, 24, 4, 2, 3],
   ![64, 32, 32, 24, 4, 4, 3],
