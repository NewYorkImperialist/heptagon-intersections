/-!
# All 412 residual graphs, together

`independent/no_a7_experiment` runs the elimination pipeline with AKR Lemma
7's filter switched off; it ends at 2,187 (class_P, class_Q, graph) triples
on 412 distinct disjointness graphs instead of at nothing.  The four
`orbit00k_impossible` theorems refute one graph from each symmetry orbit, and
the shards carry those four refutations across the orbits by relabelling.
This file collects the 412 into a single statement.

Generated by `python3 python/residual/gen_lean_symmetry.py all`.
-/

set_option maxHeartbeats 1000000
-- 412 list elements, appended 26 deep: unfolding them outruns the default
-- recursion depth.  Both options are elaborator limits; the kernel still
-- checks every step.
set_option maxRecDepth 100000

namespace Heptagon.ResidualSym
open Heptagon.Geometry

/-- The 412 disjointness graphs left by the pipeline without AKR Lemma 7,
in the order of `independent/residual_realizability/inventory.json`.  Bit `j`
of entry `i` is set when side `i` of `P` and side `j` of `Q` are disjoint. -/
def residual412 : List (Fin 7 → Nat) :=
  shard00 ++
    (shard01 ++
    (shard02 ++
    (shard03 ++
    (shard04 ++
    (shard05 ++
    (shard06 ++
    (shard07 ++
    (shard08 ++
    (shard09 ++
    (shard10 ++
    (shard11 ++
    (shard12 ++
    (shard13 ++
    (shard14 ++
    (shard15 ++
    (shard16 ++
    (shard17 ++
    (shard18 ++
    (shard19 ++
    (shard20 ++
    (shard21 ++
    (shard22 ++
    (shard23 ++
    (shard24 ++
    (shard25)))))))))))))))))))))))))

theorem residual412_length : residual412.length = 412 := by decide

/-- **No two simple heptagons in general position realize any of the 412.**

Hypotheses: the fourteen vertices are in general position, both heptagons are
simple, and the crossing pattern of the two boundaries is `g`.  Conclusion:
no such configuration exists for any `g` in the residual list.  Nothing here
is assumed about SAT solving -- the refutations are kernel-checked. -/
theorem residual_not_realizable (V : Fin 14 → Pt) (hGP : GP V)
    (hSP : SimpleP V) (hSQ : SimpleQ V) (g : Fin 7 → Nat)
    (hg : g ∈ residual412) (hR : Realizes V g) : False := by
  simp only [residual412, List.mem_append] at hg
  rcases hg with h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h
  · exact shard00_impossible V hGP hSP hSQ g h hR
  · exact shard01_impossible V hGP hSP hSQ g h hR
  · exact shard02_impossible V hGP hSP hSQ g h hR
  · exact shard03_impossible V hGP hSP hSQ g h hR
  · exact shard04_impossible V hGP hSP hSQ g h hR
  · exact shard05_impossible V hGP hSP hSQ g h hR
  · exact shard06_impossible V hGP hSP hSQ g h hR
  · exact shard07_impossible V hGP hSP hSQ g h hR
  · exact shard08_impossible V hGP hSP hSQ g h hR
  · exact shard09_impossible V hGP hSP hSQ g h hR
  · exact shard10_impossible V hGP hSP hSQ g h hR
  · exact shard11_impossible V hGP hSP hSQ g h hR
  · exact shard12_impossible V hGP hSP hSQ g h hR
  · exact shard13_impossible V hGP hSP hSQ g h hR
  · exact shard14_impossible V hGP hSP hSQ g h hR
  · exact shard15_impossible V hGP hSP hSQ g h hR
  · exact shard16_impossible V hGP hSP hSQ g h hR
  · exact shard17_impossible V hGP hSP hSQ g h hR
  · exact shard18_impossible V hGP hSP hSQ g h hR
  · exact shard19_impossible V hGP hSP hSQ g h hR
  · exact shard20_impossible V hGP hSP hSQ g h hR
  · exact shard21_impossible V hGP hSP hSQ g h hR
  · exact shard22_impossible V hGP hSP hSQ g h hR
  · exact shard23_impossible V hGP hSP hSQ g h hR
  · exact shard24_impossible V hGP hSP hSQ g h hR
  · exact shard25_impossible V hGP hSP hSQ g h hR

end Heptagon.ResidualSym

