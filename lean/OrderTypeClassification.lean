/-- Full family transcription checked against recomputation. -/
theorem classFam_eq : ∀ c : Fin 14, fam (chiro (signs c)) = classFam c := by decide +kernel

/-- Every four-side mask is contained in some member of fam: precisely
absence of an uncrossable four-subset, in the transcribed finite test. -/
def exceptional (chi : Nat → Nat → Nat → Int) : Bool :=
  let F := fam chi
  ((List.range 128).filter fun t =>
    ((List.range 7).filter fun i => t.testBit i).length == 4).all fun t =>
      F.any fun m => (t &&& m) == t

/-- Every stored class passes the exceptional four-side test. This does not
prove that all exceptional simple polygons reduce to a stored class. -/
theorem stored_classes_exceptional : ∀ c : Fin 14,
    exceptional (chiro (signs c)) = true := by
  intro c
  unfold exceptional
  rw [classFam_eq c]
  revert c
  decide +kernel

/-- Transcription of the nonadjacent-edge proper-crossing simplicity test. -/
def simple (chi : Nat → Nat → Nat → Int) : Bool :=
  (List.range 7).all fun i => (List.range 7).all fun j =>
    if i < j && (i+1)%7 != j && (j+1)%7 != i then
      !(chi i ((i+1)%7) j != chi i ((i+1)%7) ((j+1)%7) &&
        chi j ((j+1)%7) i != chi j ((j+1)%7) ((i+1)%7))
    else true

