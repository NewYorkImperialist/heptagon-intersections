def relabel (v : List Int) (cyc : List Nat) : Nat → Nat → Nat → Int :=
  fun a b c => chiro v (cyc.getD a 0) (cyc.getD b 0) (cyc.getD c 0)

/-- The full finite enumeration whose evaluation is a separate scale probe.
No theorem about this list is asserted by the subchecks above. -/
def exceptionalPolygons : List (Nat × Nat) :=
  (List.range 135).flatMap fun i => (List.range 360).filterMap fun j =>
    let chi := relabel (orderSigns i) (cycles.getD j [])
    if simple chi && exceptional chi then some (i,j) else none



/-- Python-expected pairs; exhaustiveness is not asserted here. -/
def expectedPolygons : List (Nat × Nat) := [(73, 269), (89, 49), (90, 204), (106, 141), (107, 122), (121, 102), (126, 124), (127, 281), (129, 122), (131, 69), (131, 245), (131, 351), (132, 231), (132, 245), (132, 306), (132, 340)]

structure Reduction where
  rep : Nat
  cycle : Nat
  cls : Nat
  shift : Nat
  reverse : Bool
  negative : Bool
  deriving DecidableEq

def reductions : List Reduction :=
  [⟨73, 269, 0, 0, false, false⟩,
   ⟨89, 49, 1, 0, false, false⟩,
   ⟨90, 204, 2, 0, false, false⟩,
   ⟨106, 141, 3, 0, false, false⟩,
   ⟨107, 122, 4, 0, false, false⟩,
   ⟨121, 102, 5, 0, false, false⟩,
   ⟨126, 124, 6, 0, false, false⟩,
   ⟨127, 281, 7, 0, false, false⟩,
   ⟨129, 122, 8, 0, false, false⟩,
   ⟨131, 69, 9, 0, false, false⟩,
   ⟨131, 245, 9, 0, true, false⟩,
   ⟨131, 351, 9, 0, true, false⟩,
   ⟨132, 231, 10, 0, false, false⟩,
   ⟨132, 245, 11, 0, false, false⟩,
   ⟨132, 306, 12, 0, false, false⟩,
   ⟨132, 340, 13, 0, false, false⟩]

/-- A dihedral vertex relabelling, with optional reversal of all signs. -/
def transformed (w : Reduction) : List Int :=
  let chi := relabel (orderSigns w.rep) (cycles.getD w.cycle [])
  let lab := fun a => (w.shift + if w.reverse then 7-a else a) % 7
  triples.map fun (a,b,c) => (if w.negative then -1 else 1) * chi (lab a) (lab b) (lab c)

/-- Partial result: all 16 expected polygons reduce to the stored classes,
and all 14 stored classes occur. Does not establish exhaustiveness. -/
theorem expected_reductions_checked :
    reductions.map (fun w => (w.rep,w.cycle)) = expectedPolygons ∧
    (reductions.map (fun w => w.cls)).toFinset = Finset.range 14 ∧
    ∀ w ∈ reductions, w.rep < 135 ∧ w.cycle < 360 ∧ w.cls < 14 ∧ w.shift < 7 ∧
      simple (relabel (orderSigns w.rep) (cycles.getD w.cycle [])) = true ∧
      transformed w = signs w.cls := by decide +kernel

end Heptagon.OrderTypeClassification
