    (Miss V 0 0) ∨ (Miss V 0 2) ∨ (Miss V 0 3) ∨ (Miss V 1 2) ∨ (Miss V 2 1) ∨ (Miss V 2 2) ∨ (Miss V 2 3) ∨ (Miss V 5 0) ∨ (Miss V 5 1) ∨ (Miss V 5 2) ∨ (Miss V 6 0) ∨ (Miss V 6 1) ∨ (¬ Miss V 6 2) ∨ (Miss V 6 3) := by
  by_contra hc
  have n0_0 : ¬ Miss V 0 0 := fun h => hc (Or.inl h)
  have n0_2 : ¬ Miss V 0 2 := fun h => hc (Or.inr (Or.inl h))
  have n0_3 : ¬ Miss V 0 3 := fun h => hc (Or.inr (Or.inr (Or.inl h)))
  have n1_2 : ¬ Miss V 1 2 := fun h => hc (Or.inr (Or.inr (Or.inr (Or.inl h))))
  have n2_1 : ¬ Miss V 2 1 := fun h => hc (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl h)))))
  have n2_2 : ¬ Miss V 2 2 := fun h => hc (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl h))))))
  have n2_3 : ¬ Miss V 2 3 := fun h => hc (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl h)))))))
  have n5_0 : ¬ Miss V 5 0 := fun h => hc (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl h))))))))
  have n5_1 : ¬ Miss V 5 1 := fun h => hc (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl h)))))))))
  have n5_2 : ¬ Miss V 5 2 := fun h => hc (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl h))))))))))
  have n6_0 : ¬ Miss V 6 0 := fun h => hc (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl h)))))))))))
  have n6_1 : ¬ Miss V 6 1 := fun h => hc (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl h))))))))))))
  have n6_2 : ¬ ¬ Miss V 6 2 := fun h => hc (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl h)))))))))))))
  have n6_3 : ¬ Miss V 6 3 := fun h => hc (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (h))))))))))))))
  exact MinPatternClauses001.minpattern001_impossible
    (fun i => V (![11, 10, 9, 8, 7, 13, 12, 5, 6, 0, 1, 2, 3, 4] i))
    (gp_comp hGP _ (by decide))
    (npc_swapR (npc_swapL (hSQ 3 1 (by decide))))
    (npc_swapR (npc_swapL (hSQ 3 0 (by decide))))
    (pc_swapL (pc_swapS (cross_of_not_miss 6 3 n6_3)))
    (pc_swapL (pc_swapS (cross_of_not_miss 0 3 n0_3)))
    (pc_swapL (pc_swapS (cross_of_not_miss 2 3 n2_3)))
    (npc_swapR (npc_swapL (hSQ 2 0 (by decide))))
    (pc_swapL (pc_swapS (cross_of_not_miss 5 2 n5_2)))
    (npc_swapL (npc_swapS (miss_of_not_not 6 2 n6_2)))
    (pc_swapL (pc_swapS (cross_of_not_miss 0 2 n0_2)))
    (pc_swapL (pc_swapS (cross_of_not_miss 1 2 n1_2)))
    (pc_swapL (pc_swapS (cross_of_not_miss 2 2 n2_2)))
    (pc_swapL (pc_swapS (cross_of_not_miss 5 1 n5_1)))
    (pc_swapL (pc_swapS (cross_of_not_miss 6 1 n6_1)))
    (pc_swapL (pc_swapS (cross_of_not_miss 2 1 n2_1)))
    (pc_swapL (pc_swapS (cross_of_not_miss 5 0 n5_0)))
    (pc_swapL (pc_swapS (cross_of_not_miss 6 0 n6_0)))
    (pc_swapL (pc_swapS (cross_of_not_miss 0 0 n0_0)))
    (hSP 5 0 (by decide))
    (hSP 5 1 (by decide))
    (hSP 6 1 (by decide))
    (hSP 6 2 (by decide))

/-- Avoidance clause 313/588: a relabelled copy of forbidden
pattern 1 on the 14 listed side pairs does not occur. -/
theorem avoid0313 (V : Fin 14 → Pt) (hGP : GP V)
    (hSP : SimpleP V) (hSQ : SimpleQ V) :
    (Miss V 0 1) ∨ (Miss V 0 2) ∨ (Miss V 0 3) ∨ (Miss V 3 0) ∨ (Miss V 3 1) ∨ (Miss V 3 2) ∨ (Miss V 4 1) ∨ (Miss V 5 0) ∨ (Miss V 5 1) ∨ (Miss V 5 3) ∨ (Miss V 6 0) ∨ (¬ Miss V 6 1) ∨ (Miss V 6 2) ∨ (Miss V 6 3) := by
  by_contra hc
  have n0_1 : ¬ Miss V 0 1 := fun h => hc (Or.inl h)
  have n0_2 : ¬ Miss V 0 2 := fun h => hc (Or.inr (Or.inl h))
  have n0_3 : ¬ Miss V 0 3 := fun h => hc (Or.inr (Or.inr (Or.inl h)))
  have n3_0 : ¬ Miss V 3 0 := fun h => hc (Or.inr (Or.inr (Or.inr (Or.inl h))))
  have n3_1 : ¬ Miss V 3 1 := fun h => hc (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl h)))))
  have n3_2 : ¬ Miss V 3 2 := fun h => hc (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl h))))))
  have n4_1 : ¬ Miss V 4 1 := fun h => hc (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl h)))))))
  have n5_0 : ¬ Miss V 5 0 := fun h => hc (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl h))))))))
  have n5_1 : ¬ Miss V 5 1 := fun h => hc (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl h)))))))))
  have n5_3 : ¬ Miss V 5 3 := fun h => hc (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl h))))))))))
  have n6_0 : ¬ Miss V 6 0 := fun h => hc (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl h)))))))))))
  have n6_1 : ¬ ¬ Miss V 6 1 := fun h => hc (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl h))))))))))))
  have n6_2 : ¬ Miss V 6 2 := fun h => hc (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl h)))))))))))))
  have n6_3 : ¬ Miss V 6 3 := fun h => hc (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (h))))))))))))))
  exact MinPatternClauses001.minpattern001_impossible
    (fun i => V (![7, 8, 9, 10, 11, 12, 13, 1, 0, 6, 5, 4, 3, 2] i))
    (gp_comp hGP _ (by decide))
    (hSQ 0 2 (by decide))
    (hSQ 0 3 (by decide))
    (pc_swapR (pc_swapS (cross_of_not_miss 6 0 n6_0)))
    (pc_swapR (pc_swapS (cross_of_not_miss 5 0 n5_0)))
    (pc_swapR (pc_swapS (cross_of_not_miss 3 0 n3_0)))
    (hSQ 1 3 (by decide))
    (pc_swapR (pc_swapS (cross_of_not_miss 0 1 n0_1)))
    (npc_swapR (npc_swapS (miss_of_not_not 6 1 n6_1)))
    (pc_swapR (pc_swapS (cross_of_not_miss 5 1 n5_1)))
    (pc_swapR (pc_swapS (cross_of_not_miss 4 1 n4_1)))
    (pc_swapR (pc_swapS (cross_of_not_miss 3 1 n3_1)))
    (pc_swapR (pc_swapS (cross_of_not_miss 0 2 n0_2)))
    (pc_swapR (pc_swapS (cross_of_not_miss 6 2 n6_2)))
    (pc_swapR (pc_swapS (cross_of_not_miss 3 2 n3_2)))
    (pc_swapR (pc_swapS (cross_of_not_miss 0 3 n0_3)))
    (pc_swapR (pc_swapS (cross_of_not_miss 6 3 n6_3)))
    (pc_swapR (pc_swapS (cross_of_not_miss 5 3 n5_3)))
    (npc_swapR (npc_swapL (hSP 0 5 (by decide))))
    (npc_swapR (npc_swapL (hSP 0 4 (by decide))))
    (npc_swapR (npc_swapL (hSP 6 4 (by decide))))
    (npc_swapR (npc_swapL (hSP 6 3 (by decide))))

end Heptagon.Cover
