def shard05 : List (Fin 7 → Nat) :=
  [![2, 65, 64, 32, 24, 4, 4],
   ![2, 65, 64, 32, 24, 8, 4],
   ![3, 1, 64, 48, 8, 8, 4],
   ![3, 2, 4, 24, 32, 32, 64],
