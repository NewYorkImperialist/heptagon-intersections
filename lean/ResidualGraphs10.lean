def shard10 : List (Fin 7 → Nat) :=
  [![8, 4, 3, 1, 64, 48, 8],
   ![8, 4, 3, 64, 64, 32, 24],
   ![8, 4, 3, 64, 64, 48, 8],
   ![8, 4, 4, 3, 64, 64, 48],
