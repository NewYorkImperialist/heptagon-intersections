   ![8, 8, 4, 3, 64, 64, 48],
   ![8, 8, 6, 1, 1, 64, 48],
   ![8, 8, 6, 1, 1, 96, 16]]

theorem shard10_impossible (V : Fin 14 → Pt) (hGP : GP V)
    (hSP : SimpleP V) (hSQ : SimpleQ V) (g : Fin 7 → Nat)
    (hg : g ∈ shard10) (hR : Realizes V g) : False := by
  simp only [shard10, List.mem_cons, List.not_mem_nil, or_false] at hg
  rcases hg with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
  · exact graph159_impossible V hGP hSP hSQ hR
