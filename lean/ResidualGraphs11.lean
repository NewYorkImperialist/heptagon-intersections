def shard11 : List (Fin 7 → Nat) :=
  [![8, 8, 6, 1, 64, 64, 48],
   ![8, 8, 16, 96, 1, 1, 6],
   ![8, 8, 16, 96, 64, 1, 6],
   ![8, 8, 48, 64, 1, 1, 6],
