    (pc_swapR (pc_swapL (cross_of_not_miss 1 1 n1_1)))
    (pc_swapR (pc_swapL (cross_of_not_miss 1 0 n1_0)))
    (npc_swapR (npc_swapL (hSQ 2 0 (by decide))))
    (npc_swapR (npc_swapL (hSQ 2 6 (by decide))))
