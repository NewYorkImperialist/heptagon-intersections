    (Miss V 1 3) ∨ (Miss V 1 4) ∨ (Miss V 1 6) ∨ (Miss V 2 2) ∨ (¬ Miss V 2 3) ∨ (Miss V 2 4) ∨ (Miss V 2 5) ∨ (Miss V 2 6) ∨ (Miss V 3 2) ∨ (Miss V 3 3) ∨ (Miss V 3 6) ∨ (Miss V 4 2) ∨ (Miss V 4 3) ∨ (Miss V 4 4) := by
  by_contra hc
  have n1_3 : ¬ Miss V 1 3 := fun h => hc (Or.inl h)
  have n1_4 : ¬ Miss V 1 4 := fun h => hc (Or.inr (Or.inl h))
  have n1_6 : ¬ Miss V 1 6 := fun h => hc (Or.inr (Or.inr (Or.inl h)))
  have n2_2 : ¬ Miss V 2 2 := fun h => hc (Or.inr (Or.inr (Or.inr (Or.inl h))))
  have n2_3 : ¬ ¬ Miss V 2 3 := fun h => hc (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl h)))))
  have n2_4 : ¬ Miss V 2 4 := fun h => hc (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl h))))))
  have n2_5 : ¬ Miss V 2 5 := fun h => hc (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl h)))))))
  have n2_6 : ¬ Miss V 2 6 := fun h => hc (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl h))))))))
  have n3_2 : ¬ Miss V 3 2 := fun h => hc (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl h)))))))))
  have n3_3 : ¬ Miss V 3 3 := fun h => hc (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl h))))))))))
  have n3_6 : ¬ Miss V 3 6 := fun h => hc (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl h)))))))))))
  have n4_2 : ¬ Miss V 4 2 := fun h => hc (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl h))))))))))))
  have n4_3 : ¬ Miss V 4 3 := fun h => hc (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl h)))))))))))))
  have n4_4 : ¬ Miss V 4 4 := fun h => hc (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (h))))))))))))))
  exact MinPatternClauses001.minpattern001_impossible
    (fun i => V (![1, 2, 3, 4, 5, 6, 0, 9, 10, 11, 12, 13, 7, 8] i))
    (gp_comp hGP _ (by decide))
    (hSP 1 3 (by decide))
    (hSP 1 4 (by decide))
    (cross_of_not_miss 1 3 n1_3)
    (cross_of_not_miss 1 4 n1_4)
    (cross_of_not_miss 1 6 n1_6)
    (hSP 2 4 (by decide))
    (cross_of_not_miss 2 2 n2_2)
    (miss_of_not_not 2 3 n2_3)
    (cross_of_not_miss 2 4 n2_4)
    (cross_of_not_miss 2 5 n2_5)
    (cross_of_not_miss 2 6 n2_6)
    (cross_of_not_miss 3 2 n3_2)
    (cross_of_not_miss 3 3 n3_3)
    (cross_of_not_miss 3 6 n3_6)
    (cross_of_not_miss 4 2 n4_2)
    (cross_of_not_miss 4 3 n4_3)
    (cross_of_not_miss 4 4 n4_4)
    (hSQ 2 4 (by decide))
    (hSQ 2 5 (by decide))
    (hSQ 3 5 (by decide))
    (hSQ 3 6 (by decide))

/-- Avoidance clause 117/548: a relabelled copy of forbidden
pattern 1 on the 14 listed side pairs does not occur. -/
theorem avoid0117 (V : Fin 14 → Pt) (hGP : GP V)
    (hSP : SimpleP V) (hSQ : SimpleQ V) :
    (Miss V 1 0) ∨ (Miss V 1 1) ∨ (Miss V 1 2) ∨ (Miss V 2 1) ∨ (Miss V 2 2) ∨ (Miss V 2 5) ∨ (Miss V 3 0) ∨ (¬ Miss V 3 1) ∨ (Miss V 3 2) ∨ (Miss V 3 5) ∨ (Miss V 3 6) ∨ (Miss V 4 0) ∨ (Miss V 4 1) ∨ (Miss V 4 5) := by
  by_contra hc
  have n1_0 : ¬ Miss V 1 0 := fun h => hc (Or.inl h)
  have n1_1 : ¬ Miss V 1 1 := fun h => hc (Or.inr (Or.inl h))
  have n1_2 : ¬ Miss V 1 2 := fun h => hc (Or.inr (Or.inr (Or.inl h)))
  have n2_1 : ¬ Miss V 2 1 := fun h => hc (Or.inr (Or.inr (Or.inr (Or.inl h))))
  have n2_2 : ¬ Miss V 2 2 := fun h => hc (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl h)))))
  have n2_5 : ¬ Miss V 2 5 := fun h => hc (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl h))))))
  have n3_0 : ¬ Miss V 3 0 := fun h => hc (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl h)))))))
  have n3_1 : ¬ ¬ Miss V 3 1 := fun h => hc (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl h))))))))
  have n3_2 : ¬ Miss V 3 2 := fun h => hc (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl h)))))))))
  have n3_5 : ¬ Miss V 3 5 := fun h => hc (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl h))))))))))
  have n3_6 : ¬ Miss V 3 6 := fun h => hc (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl h)))))))))))
  have n4_0 : ¬ Miss V 4 0 := fun h => hc (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl h))))))))))))
  have n4_1 : ¬ Miss V 4 1 := fun h => hc (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl h)))))))))))))
  have n4_5 : ¬ Miss V 4 5 := fun h => hc (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (h))))))))))))))
  exact MinPatternClauses001.minpattern001_impossible
    (fun i => V (![5, 4, 3, 2, 1, 0, 6, 10, 9, 8, 7, 13, 12, 11] i))
    (gp_comp hGP _ (by decide))
    (npc_swapR (npc_swapL (hSP 4 2 (by decide))))
    (npc_swapR (npc_swapL (hSP 4 1 (by decide))))
    (pc_swapR (pc_swapL (cross_of_not_miss 4 1 n4_1)))
    (pc_swapR (pc_swapL (cross_of_not_miss 4 0 n4_0)))
    (pc_swapR (pc_swapL (cross_of_not_miss 4 5 n4_5)))
    (npc_swapR (npc_swapL (hSP 3 1 (by decide))))
    (pc_swapR (pc_swapL (cross_of_not_miss 3 2 n3_2)))
    (npc_swapR (npc_swapL (miss_of_not_not 3 1 n3_1)))
    (pc_swapR (pc_swapL (cross_of_not_miss 3 0 n3_0)))
    (pc_swapR (pc_swapL (cross_of_not_miss 3 6 n3_6)))
    (pc_swapR (pc_swapL (cross_of_not_miss 3 5 n3_5)))
    (pc_swapR (pc_swapL (cross_of_not_miss 2 2 n2_2)))
    (pc_swapR (pc_swapL (cross_of_not_miss 2 1 n2_1)))
    (pc_swapR (pc_swapL (cross_of_not_miss 2 5 n2_5)))
