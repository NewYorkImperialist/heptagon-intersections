import CoverCount

set_option maxHeartbeats 1000000

/-! Row-degree clauses 40-59 of 120, generated by
`python3 python/residual/gen_lean_rowdeg.py 2`. -/

namespace Heptagon.Cover
open Heptagon.Geometry Finset


/-- Row `i` misses exactly 2 of the seven sides of `Q`, so it cannot miss all 3 of these. -/
theorem rowMost2_1_2_6 (V : Fin 14 → Pt) (i : Fin 7) (h : rowDeg V i = 2) :
    ¬ Miss V i 1 ∨ ¬ Miss V i 2 ∨ ¬ Miss V i 6 := by
  obtain ⟨j, hj, hp⟩ := row_exists_cross V (i := i) (S := {1, 2, 6}) (by rw [h]; decide)
  simp only [Finset.mem_insert, Finset.mem_singleton] at hj
  rcases hj with rfl | rfl | rfl
  · exact Or.inl hp
  · exact Or.inr (Or.inl hp)
  · exact Or.inr (Or.inr (hp))

