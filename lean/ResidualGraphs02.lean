theorem shard02_impossible (V : Fin 14 → Pt) (hGP : GP V)
    (hSP : SimpleP V) (hSQ : SimpleQ V) (g : Fin 7 → Nat)
    (hg : g ∈ shard02) (hR : Realizes V g) : False := by
  simp only [shard02, List.mem_cons, List.not_mem_nil, or_false] at hg
