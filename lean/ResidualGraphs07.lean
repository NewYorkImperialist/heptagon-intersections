/-- Residual graphs 111-126 of the 412. -/
def shard07 : List (Fin 7 → Nat) :=
  [![4, 3, 64, 64, 48, 8, 8],
   ![4, 4, 2, 65, 32, 32, 24],
   ![4, 4, 2, 65, 64, 32, 24],
   ![4, 4, 3, 64, 32, 32, 24],
   ![4, 4, 3, 64, 48, 16, 8],
   ![4, 4, 3, 64, 64, 32, 24],
   ![4, 4, 3, 64, 64, 48, 8],
   ![4, 4, 8, 48, 64, 64, 3],
   ![4, 4, 24, 32, 32, 64, 3],
   ![4, 4, 24, 32, 32, 65, 2],
   ![4, 4, 24, 32, 64, 64, 3],
   ![4, 4, 24, 32, 65, 1, 2],
   ![4, 6, 1, 64, 64, 48, 8],
   ![4, 8, 8, 48, 64, 1, 3],
   ![4, 8, 8, 48, 64, 64, 3],
   ![4, 8, 16, 48, 64, 1, 3]]

theorem shard07_impossible (V : Fin 14 → Pt) (hGP : GP V)
    (hSP : SimpleP V) (hSQ : SimpleQ V) (g : Fin 7 → Nat)
    (hg : g ∈ shard07) (hR : Realizes V g) : False := by
  simp only [shard07, List.mem_cons, List.not_mem_nil, or_false] at hg
  rcases hg with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
  · exact graph111_impossible V hGP hSP hSQ hR
  · exact graph112_impossible V hGP hSP hSQ hR
  · exact graph113_impossible V hGP hSP hSQ hR
  · exact graph114_impossible V hGP hSP hSQ hR
  · exact graph115_impossible V hGP hSP hSQ hR
  · exact graph116_impossible V hGP hSP hSQ hR
  · exact graph117_impossible V hGP hSP hSQ hR
  · exact graph118_impossible V hGP hSP hSQ hR
  · exact graph119_impossible V hGP hSP hSQ hR
  · exact graph120_impossible V hGP hSP hSQ hR
  · exact graph121_impossible V hGP hSP hSQ hR
  · exact graph122_impossible V hGP hSP hSQ hR
  · exact graph123_impossible V hGP hSP hSQ hR
  · exact graph124_impossible V hGP hSP hSQ hR
  · exact graph125_impossible V hGP hSP hSQ hR
  · exact graph126_impossible V hGP hSP hSQ hR

