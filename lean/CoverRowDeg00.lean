import CoverCount

set_option maxHeartbeats 1000000

/-! Row-degree clauses 0-19 of 120, generated by
`python3 python/residual/gen_lean_rowdeg.py 0`. -/

namespace Heptagon.Cover
open Heptagon.Geometry Finset


/-- Row `i` misses exactly 1 of the seven sides of `Q`, so it cannot miss all 2 of these. -/
theorem rowMost1_0_1 (V : Fin 14 → Pt) (i : Fin 7) (h : rowDeg V i = 1) :
    ¬ Miss V i 0 ∨ ¬ Miss V i 1 := by
  obtain ⟨j, hj, hp⟩ := row_exists_cross V (i := i) (S := {0, 1}) (by rw [h]; decide)
  simp only [Finset.mem_insert, Finset.mem_singleton] at hj
  rcases hj with rfl | rfl
  · exact Or.inl hp
  · exact Or.inr (hp)

