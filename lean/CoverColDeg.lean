import CoverCount

set_option maxHeartbeats 1000000

/-!
# Column at-most-one clauses

Generated by `python3 python/residual/gen_lean_coldeg.py`.

If side `j` of `Q` misses exactly one side of `P`, it cannot miss two.
-/

namespace Heptagon.Cover
open Heptagon.Geometry Finset


/-- Column `j` misses exactly one side of `P`, so not both `0` and `1`. -/
theorem colMost1_0_1 (V : Fin 14 → Pt) (j : Fin 7) (h : colDeg V j = 1) :
    ¬ Miss V 0 j ∨ ¬ Miss V 1 j := by
  obtain ⟨i, hi, hp⟩ := col_exists_cross V (j := j) (S := {0, 1}) (by rw [h]; decide)
  simp only [Finset.mem_insert, Finset.mem_singleton] at hi
  rcases hi with rfl | rfl
  · exact Or.inl hp
  · exact Or.inr hp

