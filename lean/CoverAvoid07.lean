    (Miss V 0 3) ∨ (Miss V 0 4) ∨ (Miss V 0 5) ∨ (Miss V 1 3) ∨ (Miss V 1 4) ∨ (¬ Miss V 1 5) ∨ (Miss V 1 6) ∨ (Miss V 2 3) ∨ (Miss V 2 5) ∨ (Miss V 2 6) ∨ (Miss V 3 5) ∨ (Miss V 4 4) ∨ (Miss V 4 5) ∨ (Miss V 4 6) := by
  by_contra hc
  have n0_3 : ¬ Miss V 0 3 := fun h => hc (Or.inl h)
  have n0_4 : ¬ Miss V 0 4 := fun h => hc (Or.inr (Or.inl h))
  have n0_5 : ¬ Miss V 0 5 := fun h => hc (Or.inr (Or.inr (Or.inl h)))
  have n1_3 : ¬ Miss V 1 3 := fun h => hc (Or.inr (Or.inr (Or.inr (Or.inl h))))
  have n1_4 : ¬ Miss V 1 4 := fun h => hc (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl h)))))
  have n1_5 : ¬ ¬ Miss V 1 5 := fun h => hc (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl h))))))
  have n1_6 : ¬ Miss V 1 6 := fun h => hc (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl h)))))))
  have n2_3 : ¬ Miss V 2 3 := fun h => hc (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl h))))))))
  have n2_5 : ¬ Miss V 2 5 := fun h => hc (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl h)))))))))
  have n2_6 : ¬ Miss V 2 6 := fun h => hc (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl h))))))))))
  have n3_5 : ¬ Miss V 3 5 := fun h => hc (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl h)))))))))))
  have n4_4 : ¬ Miss V 4 4 := fun h => hc (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl h))))))))))))
  have n4_5 : ¬ Miss V 4 5 := fun h => hc (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl h)))))))))))))
  have n4_6 : ¬ Miss V 4 6 := fun h => hc (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (h))))))))))))))
  exact MinPatternClauses001.minpattern001_impossible
    (fun i => V (![7, 13, 12, 11, 10, 9, 8, 0, 1, 2, 3, 4, 5, 6] i))
    (gp_comp hGP _ (by decide))
    (npc_swapR (npc_swapL (hSQ 6 4 (by decide))))
    (npc_swapR (npc_swapL (hSQ 6 3 (by decide))))
    (pc_swapL (pc_swapS (cross_of_not_miss 1 6 n1_6)))
    (pc_swapL (pc_swapS (cross_of_not_miss 2 6 n2_6)))
    (pc_swapL (pc_swapS (cross_of_not_miss 4 6 n4_6)))
    (npc_swapR (npc_swapL (hSQ 5 3 (by decide))))
    (pc_swapL (pc_swapS (cross_of_not_miss 0 5 n0_5)))
    (npc_swapL (npc_swapS (miss_of_not_not 1 5 n1_5)))
    (pc_swapL (pc_swapS (cross_of_not_miss 2 5 n2_5)))
    (pc_swapL (pc_swapS (cross_of_not_miss 3 5 n3_5)))
    (pc_swapL (pc_swapS (cross_of_not_miss 4 5 n4_5)))
    (pc_swapL (pc_swapS (cross_of_not_miss 0 4 n0_4)))
    (pc_swapL (pc_swapS (cross_of_not_miss 1 4 n1_4)))
    (pc_swapL (pc_swapS (cross_of_not_miss 4 4 n4_4)))
    (pc_swapL (pc_swapS (cross_of_not_miss 0 3 n0_3)))
    (pc_swapL (pc_swapS (cross_of_not_miss 1 3 n1_3)))
    (pc_swapL (pc_swapS (cross_of_not_miss 2 3 n2_3)))
    (hSP 0 2 (by decide))
    (hSP 0 3 (by decide))
    (hSP 1 3 (by decide))
    (hSP 1 4 (by decide))

/-- Avoidance clause 155/588: a relabelled copy of forbidden
pattern 1 on the 14 listed side pairs does not occur. -/
theorem avoid0155 (V : Fin 14 → Pt) (hGP : GP V)
    (hSP : SimpleP V) (hSQ : SimpleQ V) :
    (Miss V 1 1) ∨ (Miss V 1 5) ∨ (Miss V 1 6) ∨ (Miss V 2 0) ∨ (Miss V 2 1) ∨ (Miss V 2 4) ∨ (¬ Miss V 2 5) ∨ (Miss V 2 6) ∨ (Miss V 3 1) ∨ (Miss V 3 4) ∨ (Miss V 3 5) ∨ (Miss V 4 4) ∨ (Miss V 4 5) ∨ (Miss V 4 6) := by
  by_contra hc
  have n1_1 : ¬ Miss V 1 1 := fun h => hc (Or.inl h)
  have n1_5 : ¬ Miss V 1 5 := fun h => hc (Or.inr (Or.inl h))
  have n1_6 : ¬ Miss V 1 6 := fun h => hc (Or.inr (Or.inr (Or.inl h)))
  have n2_0 : ¬ Miss V 2 0 := fun h => hc (Or.inr (Or.inr (Or.inr (Or.inl h))))
  have n2_1 : ¬ Miss V 2 1 := fun h => hc (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl h)))))
  have n2_4 : ¬ Miss V 2 4 := fun h => hc (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl h))))))
  have n2_5 : ¬ ¬ Miss V 2 5 := fun h => hc (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl h)))))))
  have n2_6 : ¬ Miss V 2 6 := fun h => hc (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl h))))))))
  have n3_1 : ¬ Miss V 3 1 := fun h => hc (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl h)))))))))
  have n3_4 : ¬ Miss V 3 4 := fun h => hc (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl h))))))))))
  have n3_5 : ¬ Miss V 3 5 := fun h => hc (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl h)))))))))))
  have n4_4 : ¬ Miss V 4 4 := fun h => hc (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl h))))))))))))
  have n4_5 : ¬ Miss V 4 5 := fun h => hc (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inl h)))))))))))))
  have n4_6 : ¬ Miss V 4 6 := fun h => hc (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (Or.inr (h))))))))))))))
  exact MinPatternClauses001.minpattern001_impossible
    (fun i => V (![1, 2, 3, 4, 5, 6, 0, 11, 12, 13, 7, 8, 9, 10] i))
    (gp_comp hGP _ (by decide))
    (hSP 1 3 (by decide))
    (hSP 1 4 (by decide))
    (cross_of_not_miss 1 5 n1_5)
    (cross_of_not_miss 1 6 n1_6)
    (cross_of_not_miss 1 1 n1_1)
    (hSP 2 4 (by decide))
    (cross_of_not_miss 2 4 n2_4)
    (miss_of_not_not 2 5 n2_5)
    (cross_of_not_miss 2 6 n2_6)
    (cross_of_not_miss 2 0 n2_0)
    (cross_of_not_miss 2 1 n2_1)
    (cross_of_not_miss 3 4 n3_4)
    (cross_of_not_miss 3 5 n3_5)
    (cross_of_not_miss 3 1 n3_1)
    (cross_of_not_miss 4 4 n4_4)
    (cross_of_not_miss 4 5 n4_5)
    (cross_of_not_miss 4 6 n4_6)
    (hSQ 4 6 (by decide))
    (hSQ 4 0 (by decide))
    (hSQ 5 0 (by decide))
    (hSQ 5 1 (by decide))

/-- Avoidance clause 156/588: a relabelled copy of forbidden
pattern 0 on the 8 listed side pairs does not occur. -/
theorem avoid0156 (V : Fin 14 → Pt) (hGP : GP V)
    (hSP : SimpleP V) (hSQ : SimpleQ V) :
    (Miss V 2 4) ∨ (Miss V 2 5) ∨ (Miss V 3 4) ∨ (¬ Miss V 3 5) ∨ (Miss V 3 6) ∨ (Miss V 4 4) ∨ (Miss V 4 5) ∨ (Miss V 4 6) := by
  by_contra hc
  have n2_4 : ¬ Miss V 2 4 := fun h => hc (Or.inl h)
  have n2_5 : ¬ Miss V 2 5 := fun h => hc (Or.inr (Or.inl h))
