/-!
# The covering step

Generated by `python3 python/residual/gen_lean_cover_all.py`.

A configuration whose two heptagons cross 40 times has 9 disjoint side
pairs, so its seven row degrees are each at least 1 and sum to 9.  There
are 28 such degree vectors (`CoverShape.degree_shape`), and each is
refuted by one of the 28 `coverCase<k>r<r>` theorems.

## What this assumes, and why

`hcol` -- every side of `Q` misses some side of `P` -- is carried as a
hypothesis rather than proved.  The project *does* prove it, in
`DisjointnessGraph.exists_disjointO_Pside`, but for a `Config`, and these
theorems are stated for a bare `V : Fin 14 → Pt` with a general-position
hypothesis `GP` that is stronger than what `Config` supplies.  Connecting
them is the same piece of work as closing the general-position gap of
`docs/residual-412-lean.md` §4, and it is not done.  See `CoverColumn.lean`.
-/

namespace Heptagon.Cover
open Heptagon.Geometry Heptagon.ResidualSym

/-- **The covering step.**  No configuration of fourteen points in general
position, tracing two simple heptagons, has exactly nine disjoint side pairs
— equivalently, none has exactly 40 properly crossing side pairs.

`hcol` is the one non-geometric hypothesis; see the note above. -/
theorem no_nine_edges (V : Fin 14 → Pt) (hGP : GP V)
    (hSP : SimpleP V) (hSQ : SimpleQ V)
    (hcol : ∀ j : Fin 7, 0 < colDeg V j)
    (hrow : ∀ i : Fin 7, 0 < rowDeg V i)
    (htot : rowDeg V 0 + rowDeg V 1 + rowDeg V 2 + rowDeg V 3 + rowDeg V 4
      + rowDeg V 5 + rowDeg V 6 = 9) : False := by
  have h0 := hrow 0; have h1 := hrow 1; have h2 := hrow 2; have h3 := hrow 3
  have h4 := hrow 4; have h5 := hrow 5; have h6 := hrow 6
  -- Each degree is below 4: one of 4 or more would leave the other six, each
  -- at least 1, unable to bring the total down to 9.  Stated one row at a
  -- time rather than by `fin_cases` on a ∀, because `fin_cases` leaves the
  -- index as an anonymous constructor and `omega` then cannot match the goal
  -- against the `hrow i` hypotheses.
  have hb0 : rowDeg V 0 < 4 := by omega
  have hb1 : rowDeg V 1 < 4 := by omega
  have hb2 : rowDeg V 2 < 4 := by omega
  have hb3 : rowDeg V 3 < 4 := by omega
  have hb4 : rowDeg V 4 < 4 := by omega
  have hb5 : rowDeg V 5 < 4 := by omega
  have hb6 : rowDeg V 6 < 4 := by omega
  -- `(⟨rowDeg V i, _⟩ : Fin 4).val` is definitionally `rowDeg V i`, so the
  -- degree hypotheses and the total pass straight through.
  have hs := degree_shape ⟨rowDeg V 0, hb0⟩ ⟨rowDeg V 1, hb1⟩ ⟨rowDeg V 2, hb2⟩ ⟨rowDeg V 3, hb3⟩ ⟨rowDeg V 4, hb4⟩ ⟨rowDeg V 5, hb5⟩ ⟨rowDeg V 6, hb6⟩
    (hrow 0) (hrow 1) (hrow 2) (hrow 3) (hrow 4) (hrow 5) (hrow 6) htot
  rcases hs with h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h | h
  · exact coverCase0r0 V hGP hSP hSQ hcol h.1 h.2.1 h.2.2.1 h.2.2.2.1 h.2.2.2.2.1 h.2.2.2.2.2.1 h.2.2.2.2.2.2
  · exact coverCase0r1 V hGP hSP hSQ hcol h.1 h.2.1 h.2.2.1 h.2.2.2.1 h.2.2.2.2.1 h.2.2.2.2.2.1 h.2.2.2.2.2.2
  · exact coverCase0r2 V hGP hSP hSQ hcol h.1 h.2.1 h.2.2.1 h.2.2.2.1 h.2.2.2.2.1 h.2.2.2.2.2.1 h.2.2.2.2.2.2
  · exact coverCase0r3 V hGP hSP hSQ hcol h.1 h.2.1 h.2.2.1 h.2.2.2.1 h.2.2.2.2.1 h.2.2.2.2.2.1 h.2.2.2.2.2.2
  · exact coverCase0r4 V hGP hSP hSQ hcol h.1 h.2.1 h.2.2.1 h.2.2.2.1 h.2.2.2.2.1 h.2.2.2.2.2.1 h.2.2.2.2.2.2
  · exact coverCase0r5 V hGP hSP hSQ hcol h.1 h.2.1 h.2.2.1 h.2.2.2.1 h.2.2.2.2.1 h.2.2.2.2.2.1 h.2.2.2.2.2.2
  · exact coverCase0r6 V hGP hSP hSQ hcol h.1 h.2.1 h.2.2.1 h.2.2.2.1 h.2.2.2.2.1 h.2.2.2.2.2.1 h.2.2.2.2.2.2
  · exact coverCase1r0 V hGP hSP hSQ hcol h.1 h.2.1 h.2.2.1 h.2.2.2.1 h.2.2.2.2.1 h.2.2.2.2.2.1 h.2.2.2.2.2.2
  · exact coverCase1r1 V hGP hSP hSQ hcol h.1 h.2.1 h.2.2.1 h.2.2.2.1 h.2.2.2.2.1 h.2.2.2.2.2.1 h.2.2.2.2.2.2
  · exact coverCase1r2 V hGP hSP hSQ hcol h.1 h.2.1 h.2.2.1 h.2.2.2.1 h.2.2.2.2.1 h.2.2.2.2.2.1 h.2.2.2.2.2.2
  · exact coverCase1r3 V hGP hSP hSQ hcol h.1 h.2.1 h.2.2.1 h.2.2.2.1 h.2.2.2.2.1 h.2.2.2.2.2.1 h.2.2.2.2.2.2
  · exact coverCase1r4 V hGP hSP hSQ hcol h.1 h.2.1 h.2.2.1 h.2.2.2.1 h.2.2.2.2.1 h.2.2.2.2.2.1 h.2.2.2.2.2.2
  · exact coverCase1r5 V hGP hSP hSQ hcol h.1 h.2.1 h.2.2.1 h.2.2.2.1 h.2.2.2.2.1 h.2.2.2.2.2.1 h.2.2.2.2.2.2
  · exact coverCase1r6 V hGP hSP hSQ hcol h.1 h.2.1 h.2.2.1 h.2.2.2.1 h.2.2.2.2.1 h.2.2.2.2.2.1 h.2.2.2.2.2.2
  · exact coverCase2r0 V hGP hSP hSQ hcol h.1 h.2.1 h.2.2.1 h.2.2.2.1 h.2.2.2.2.1 h.2.2.2.2.2.1 h.2.2.2.2.2.2
  · exact coverCase2r1 V hGP hSP hSQ hcol h.1 h.2.1 h.2.2.1 h.2.2.2.1 h.2.2.2.2.1 h.2.2.2.2.2.1 h.2.2.2.2.2.2
  · exact coverCase2r2 V hGP hSP hSQ hcol h.1 h.2.1 h.2.2.1 h.2.2.2.1 h.2.2.2.2.1 h.2.2.2.2.2.1 h.2.2.2.2.2.2
  · exact coverCase2r3 V hGP hSP hSQ hcol h.1 h.2.1 h.2.2.1 h.2.2.2.1 h.2.2.2.2.1 h.2.2.2.2.2.1 h.2.2.2.2.2.2
  · exact coverCase2r4 V hGP hSP hSQ hcol h.1 h.2.1 h.2.2.1 h.2.2.2.1 h.2.2.2.2.1 h.2.2.2.2.2.1 h.2.2.2.2.2.2
  · exact coverCase2r5 V hGP hSP hSQ hcol h.1 h.2.1 h.2.2.1 h.2.2.2.1 h.2.2.2.2.1 h.2.2.2.2.2.1 h.2.2.2.2.2.2
  · exact coverCase2r6 V hGP hSP hSQ hcol h.1 h.2.1 h.2.2.1 h.2.2.2.1 h.2.2.2.2.1 h.2.2.2.2.2.1 h.2.2.2.2.2.2
  · exact coverCase3r0 V hGP hSP hSQ hcol h.1 h.2.1 h.2.2.1 h.2.2.2.1 h.2.2.2.2.1 h.2.2.2.2.2.1 h.2.2.2.2.2.2
  · exact coverCase3r1 V hGP hSP hSQ hcol h.1 h.2.1 h.2.2.1 h.2.2.2.1 h.2.2.2.2.1 h.2.2.2.2.2.1 h.2.2.2.2.2.2
  · exact coverCase3r2 V hGP hSP hSQ hcol h.1 h.2.1 h.2.2.1 h.2.2.2.1 h.2.2.2.2.1 h.2.2.2.2.2.1 h.2.2.2.2.2.2
  · exact coverCase3r3 V hGP hSP hSQ hcol h.1 h.2.1 h.2.2.1 h.2.2.2.1 h.2.2.2.2.1 h.2.2.2.2.2.1 h.2.2.2.2.2.2
  · exact coverCase3r4 V hGP hSP hSQ hcol h.1 h.2.1 h.2.2.1 h.2.2.2.1 h.2.2.2.2.1 h.2.2.2.2.2.1 h.2.2.2.2.2.2
  · exact coverCase3r5 V hGP hSP hSQ hcol h.1 h.2.1 h.2.2.1 h.2.2.2.1 h.2.2.2.2.1 h.2.2.2.2.2.1 h.2.2.2.2.2.2
  · exact coverCase3r6 V hGP hSP hSQ hcol h.1 h.2.1 h.2.2.1 h.2.2.2.1 h.2.2.2.2.1 h.2.2.2.2.2.1 h.2.2.2.2.2.2

