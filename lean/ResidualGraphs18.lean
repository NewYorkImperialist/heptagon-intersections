   ![32, 32, 65, 2, 2, 4, 24],
   ![32, 32, 65, 2, 2, 12, 16],
   ![32, 32, 65, 2, 4, 4, 24],
   ![32, 64, 3, 2, 4, 24, 32],
   ![32, 64, 3, 4, 4, 24, 32],
   ![32, 64, 64, 3, 4, 4, 24]]

theorem shard18_impossible (V : Fin 14 → Pt) (hGP : GP V)
    (hSP : SimpleP V) (hSQ : SimpleQ V) (g : Fin 7 → Nat)
    (hg : g ∈ shard18) (hR : Realizes V g) : False := by
  simp only [shard18, List.mem_cons, List.not_mem_nil, or_false] at hg
  rcases hg with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
  · exact graph286_impossible V hGP hSP hSQ hR
