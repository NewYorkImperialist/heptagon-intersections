/-- Residual graphs 286-301 of the 412. -/
def shard18 : List (Fin 7 → Nat) :=
  [![32, 24, 4, 4, 3, 64, 64],
   ![32, 24, 8, 4, 2, 2, 65],
   ![32, 24, 8, 4, 3, 64, 64],
   ![32, 32, 16, 12, 2, 2, 65],
